---
interface Crumb {
  label: string;
  href: string; // absolute path, e.g. "/pool-pump-repair/"
}

interface Props {
  items: Crumb[]; // does not include "Home" — added automatically
}

const { items } = Astro.props;
const allCrumbs: Crumb[] = [{ label: 'Home', href: '/' }, ...items];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: allCrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).toString(),
  })),
};
---

<nav class="container breadcrumbs" aria-label="Breadcrumb">
  {allCrumbs.map((crumb, i) => (
    <>
      {i > 0 && <span class="breadcrumbs__sep" aria-hidden="true">/</span>}
      {i === allCrumbs.length - 1 ? (
        <span aria-current="page">{crumb.label}</span>
      ) : (
        <a href={crumb.href}>{crumb.label}</a>
      )}
    </>
  ))}
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .breadcrumbs {
    padding-top: var(--space-sm);
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .breadcrumbs a {
    color: var(--color-ink-muted);
  }

  .breadcrumbs a:hover {
    color: var(--color-prime-blue);
  }

  .breadcrumbs__sep {
    margin: 0 6px;
  }
</style>
