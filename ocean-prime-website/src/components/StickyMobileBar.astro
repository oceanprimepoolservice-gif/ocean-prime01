---
import business from '../data/business.json';
---

<div class="sticky-bar">
  <a href={business.phoneHref} class="btn btn--outline btn--block">Call Now</a>
  <a href="#quote-form" class="btn btn--primary btn--block">Get Quote</a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    gap: var(--space-xs);
    padding: 10px var(--space-sm);
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    /* Respect safe-area for iOS home indicator */
    padding-bottom: calc(10px + env(safe-area-inset-bottom));
  }

  @media (min-width: 1024px) {
    .sticky-bar {
      display: none;
    }
  }
</style>
