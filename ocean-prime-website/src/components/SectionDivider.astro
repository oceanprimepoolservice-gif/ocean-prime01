---
// Original wave-shaped divider — echoes the logo's wave mark and the
// "Ocean" brand, used between sections instead of a hard edge for a more
// premium, dynamic transition. `flip` mirrors it vertically so consecutive
// dividers don't look identical, and `into` sets which section color it
// transitions into.
interface Props {
  into?: 'white' | 'tint';
  flip?: boolean;
}

const { into = 'white', flip = false } = Astro.props;
const fill = into === 'white' ? '#FFFFFF' : '#F5FAFE';
---

<div class:list={['divider', { 'divider--flip': flip }]} aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path
      d="M0,20 C150,55 350,0 600,25 C850,50 1050,5 1200,30 L1200,60 L0,60 Z"
      fill={fill}
    />
  </svg>
</div>

<style>
  .divider {
    display: block;
    width: 100%;
    height: 36px;
    line-height: 0;
    margin-top: -1px;
  }

  .divider svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .divider--flip {
    transform: scaleX(-1);
  }

  @media (min-width: 1024px) {
    .divider {
      height: 56px;
    }
  }
</style>
