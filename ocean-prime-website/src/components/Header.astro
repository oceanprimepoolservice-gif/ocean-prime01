<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height-mobile);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
  }

  .site-header__logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  .site-header__logo:hover {
    text-decoration: none;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__call-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-ocean-blue);
    color: var(--color-white);
  }

  .site-header__call-btn:hover {
    color: var(--color-white);
    text-decoration: none;
  }

  .site-header__menu-btn {
    display: flex;
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 4px;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .mobile-menu a {
    padding: 14px var(--space-sm);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--fs-body);
  }

  .mobile-menu a:hover {
    text-decoration: none;
    background: var(--color-prime-blue-tint);
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      height: var(--header-height-desktop);
    }

    .site-header__logo img {
      height: 48px;
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }

    .site-header__nav > a,
    .nav-item__trigger {
      font-family: var(--font-body);
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--color-ink);
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px 0;
    }

    .site-header__nav > a:hover,
    .nav-item__trigger:hover {
      color: var(--color-prime-blue);
      text-decoration: none;
    }

    .nav-item {
      position: relative;
    }

    .nav-item__dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: var(--space-xs);
      min-width: 220px;
      box-shadow: 0 4px 12px rgba(22, 35, 46, 0.08);
    }

    .nav-item:hover .nav-item__dropdown,
    .nav-item:focus-within .nav-item__dropdown {
      display: block;
    }

    .nav-item__dropdown a {
      display: block;
      padding: 8px 12px;
      font-size: var(--fs-small);
      border-radius: 6px;
      color: var(--color-ink);
    }

    .nav-item__dropdown a:hover {
      background: var(--color-prime-blue-tint);
      text-decoration: none;
      color: var(--color-prime-blue);
    }

    .site-header__menu-btn {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hasAttribute('hidden') === false;
    if (isOpen) {
      menu?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      menu?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>
