---
import business from '../data/business.json';

interface Props {
  simplified?: boolean; // true on Ads landing pages — logo, phone, one CTA only
}

const { simplified = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo">{business.businessName}</a>

    {simplified ? (
      <a href={business.phoneHref} class="site-header__call-btn" aria-label={`Call ${business.phone}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
    ) : (
      <>
        <nav class="site-header__nav" aria-label="Primary">
          <div class="nav-item">
            <button class="nav-item__trigger">Pool Service</button>
            <div class="nav-item__dropdown">
              <a href="/weekly-pool-service/">Weekly Pool Service</a>
              <a href="/pool-cleaning/">Pool Cleaning</a>
              <a href="/pool-maintenance/">Pool Maintenance</a>
              <a href="/green-pool-cleanup/">Green Pool Cleanup</a>
              <a href="/seasonal-vacation-pool-care/">Seasonal & Vacation Care</a>
            </div>
          </div>
          <div class="nav-item">
            <button class="nav-item__trigger">Repairs</button>
            <div class="nav-item__dropdown">
              <a href="/pool-equipment-repair/">Pool Equipment Repair</a>
              <a href="/pool-pump-repair/">Pump Repair</a>
              <a href="/pool-pump-replacement/">Pump Replacement</a>
              <a href="/pool-heater-repair/">Heater Repair</a>
              <a href="/pool-heater-installation/">Heater Installation</a>
              <a href="/pool-filter-repair-replacement/">Filter Repair & Replacement</a>
              <a href="/salt-system-repair/">Salt System Repair</a>
              <a href="/pool-automation-repair/">Automation Repair</a>
              <a href="/pool-light-repair/">Pool Light Repair</a>
              <a href="/pool-renovation/">Pool Renovation</a>
            </div>
          </div>
          <a href="/pool-service-plans/">Service Plans</a>
          <div class="nav-item">
            <button class="nav-item__trigger">Service Areas</button>
            <div class="nav-item__dropdown">
              <a href="/service-areas/naples-fl/">Naples</a>
              <a href="/service-areas/bonita-springs-fl/">Bonita Springs</a>
              <a href="/service-areas/estero-fl/">Estero</a>
              <a href="/service-areas/marco-island-fl/">Marco Island</a>
            </div>
          </div>
          <a href="/reviews/">Reviews</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>

        <div class="site-header__actions">
          <a href={business.phoneHref} class="site-header__call-btn" aria-label={`Call ${business.phone}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <button class="site-header__menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
          </button>
        </div>
      </>
    )}
  </div>

  {!simplified && (
    <div class="mobile-menu" id="mobile-menu" hidden>
      <a href="/weekly-pool-service/">Pool Service</a>
      <a href="/pool-equipment-repair/">Repairs</a>
      <a href="/pool-service-plans/">Service Plans</a>
      <a href="/reviews/">Reviews</a>
      <a href="/service-areas/">Service Areas</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </div>
  )}
</header>

