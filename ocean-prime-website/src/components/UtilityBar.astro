---
import business from '../data/business.json';
---

<div class="utility-bar">
  <a href={business.phoneHref} class="utility-bar__phone">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    {business.phone}
  </a>
  <a href="#quote-form" class="utility-bar__cta">Get a Free Quote</a>
</div>

<style>
  .utility-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--utility-bar-height);
    padding: 0 var(--space-sm);
    background: var(--color-ink);
  }

  .utility-bar__phone {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-white);
    font-size: 12px;
  }

  .utility-bar__phone:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .utility-bar__cta {
    color: var(--color-prime-blue);
    font-size: 12px;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .utility-bar {
      padding: 0 var(--space-md);
    }
    .utility-bar__phone {
      font-size: 13px;
    }
    .utility-bar__cta {
      font-size: 13px;
    }
  }
</style>
