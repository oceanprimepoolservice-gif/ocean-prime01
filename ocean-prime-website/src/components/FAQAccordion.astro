---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

// Only include items in schema that don't contain unresolved placeholders —
// publishing a "[Needs confirmation]" answer as structured data would show
// that placeholder text directly in Google's FAQ rich results.
const schemaReadyItems = items.filter((item) => !item.answer.includes('['));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: schemaReadyItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" name={`faq-group-${Math.random()}`}>
      <summary class="faq__question">
        {item.question}
        <svg class="faq__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <p class="faq__answer">{item.answer}</p>
    </details>
  ))}
</div>

{schemaReadyItems.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<style>
  .faq__item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-body);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  .faq__answer {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-small);
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-ocean-blue);
    outline-offset: 2px;
  }
</style>
