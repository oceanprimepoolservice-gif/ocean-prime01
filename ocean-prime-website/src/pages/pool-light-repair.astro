---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import business from '../data/business.json';

const faqs = [
  { question: 'Is pool light repair dangerous to do myself?', answer: 'Pool lighting involves electrical work around water, so it should always be handled by a professional. Our technicians follow proper safety procedures on every repair.' },
  { question: 'Can you convert my pool light to LED?', answer: '[Needs confirmation \u2014 does Ocean Prime offer LED conversion?]' },
  { question: 'Why does my pool light flicker?', answer: 'Flickering is often caused by a loose connection, a failing bulb, or moisture intrusion in the fixture \u2014 we\u2019ll identify the specific cause.' },
  { question: 'Do you repair color-changing pool lights?', answer: 'Yes \u2014 including troubleshooting controller and color-cycling issues.' },
];
---

<BaseLayout
  title="Pool Light Repair in Naples, FL | Ocean Prime Pool Service"
  description="Safe, professional pool and spa light repair in Naples, Bonita Springs, Estero & Marco Island."
  path="/pool-light-repair/"
  simplifiedHeader={true}
>
  <section class="section container">
    <h1>Pool Light Repair in Naples, Florida</h1>
    <p style="max-width: 60ch;">Safe, professional repair for pool and spa lighting.</p>
    <div style="display:flex; gap: var(--space-xs); flex-wrap:wrap;">
      <a href={business.phoneHref} class="btn btn--primary">Call for Light Repair</a>
      <a href="#quote-form" class="btn btn--outline">Request a Repair Appointment</a>
    </div>
    <div class="image-placeholder">Real photo placeholder &mdash; pool light repair</div>
  </section>

  <section class="section container">
    <QuoteForm heading="Request a Repair Appointment" variant="repair" />
  </section>

  <section class="section section--tint container">
    <h2>Signs Your Pool Light Needs Repair</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>Light won't turn on</li>
      <li>Flickering or inconsistent lighting</li>
      <li>Water intrusion in the fixture</li>
      <li>Cracked or fogged lens</li>
      <li>Color-changing light stuck or malfunctioning</li>
    </ul>
  </section>

  <section class="section container">
    <h2>What's Included</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>Electrical safety check</li>
      <li>Fixture and seal inspection</li>
      <li>Bulb or fixture replacement as needed</li>
      <li>Controller check for color-changing systems</li>
    </ul>
  </section>

  <section class="section section--tint container">
    <h2>Pool Light Repair Throughout Southwest Florida</h2>
    <p>In addition to Naples, Ocean Prime repairs pool lighting in Bonita Springs, Estero, and Marco Island. <a href="/service-areas/">See our full service area &rarr;</a></p>
  </section>

  <section class="section container">
    <h2>Light Repair Questions</h2>
    <FAQAccordion items={faqs} />
  </section>

  <section class="section section--tint">
    <div class="container" style="text-align:center;">
      <h2>Light Up Your Pool Safely Again</h2>
      <p>Request a repair appointment and we'll handle it safely and correctly.</p>
      <div style="display:flex; gap: var(--space-xs); justify-content:center; flex-wrap:wrap;">
        <a href="#quote-form" class="btn btn--primary">Request a Repair Appointment</a>
        <a href={business.phoneHref} class="btn btn--outline">Call Ocean Prime</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .image-placeholder {
    margin-top: var(--space-md);
    height: 220px;
    border-radius: var(--radius-card);
    background: var(--color-prime-blue-tint);
    border: 1px dashed var(--color-prime-blue-border);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-prime-blue);
    font-size: var(--fs-small);
    padding: 0 var(--space-md);
  }
</style>
