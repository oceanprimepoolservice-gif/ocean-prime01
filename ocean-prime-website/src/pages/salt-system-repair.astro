---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import business from '../data/business.json';

const faqs = [
  { question: 'How often does a salt cell need to be replaced?', answer: '[Needs confirmation \u2014 typical guidance varies by usage and cell type]' },
  { question: 'Why is my salt reading off even though I added salt?', answer: 'This can point to a cell reading issue, uneven mixing, or a power center problem rather than an actual salt level issue \u2014 we\u2019ll test to find the real cause.' },
  { question: 'What causes low chlorine production?', answer: 'Cell scaling, low salt levels, poor flow, or a failing power center can all reduce chlorine output. We\u2019ll diagnose which one applies to your system.' },
  { question: 'Do you service all salt system brands?', answer: '[Needs confirmation \u2014 list actual supported brands]' },
];
---

<BaseLayout
  title="Salt System Repair in Naples, FL | Ocean Prime Pool Service"
  description="Professional salt chlorine generator repair in Naples, Bonita Springs, Estero & Marco Island. Fix cell, flow, and power-center problems."
  path="/salt-system-repair/"
  simplifiedHeader={true}
>
  <section class="section container">
    <h1>Salt System Repair in Naples, Florida</h1>
    <p style="max-width: 60ch;">Restore proper chlorine production and fix cell, flow, or power-center problems.</p>
    <div style="display:flex; gap: var(--space-xs); flex-wrap:wrap;">
      <a href={business.phoneHref} class="btn btn--primary">Call for Salt System Service</a>
      <a href="#quote-form" class="btn btn--outline">Request a Repair Appointment</a>
    </div>
    <div class="image-placeholder">Real photo placeholder &mdash; technician inspecting a salt cell</div>
  </section>

  <section class="section container">
    <QuoteForm heading="Request a Repair Appointment" variant="repair" />
  </section>

  <section class="section section--tint container">
    <h2>Signs Your Salt System Needs Attention</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>Low chlorine production</li>
      <li>Visible scaling on the cell</li>
      <li>Flow error messages</li>
      <li>Power-center errors or shutdowns</li>
      <li>Salt readings that don't match test strips</li>
    </ul>
  </section>

  <section class="section container">
    <h2>What's Included</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>Cell inspection for scaling and wear</li>
      <li>Salt-level testing</li>
      <li>Power center check</li>
      <li>Clear replacement recommendation when the cell is at end of life</li>
    </ul>
  </section>

  <section class="section section--tint container">
    <h2>Salt System Repair Throughout Southwest Florida</h2>
    <p>In addition to Naples, Ocean Prime repairs salt systems in Bonita Springs, Estero, and Marco Island. <a href="/service-areas/">See our full service area &rarr;</a></p>
  </section>

  <section class="section container">
    <h2>Salt System Questions</h2>
    <FAQAccordion items={faqs} />
  </section>

  <section class="section section--tint">
    <div class="container" style="text-align:center;">
      <h2>Get Your Salt System Producing Chlorine Again</h2>
      <p>Request a repair appointment and we'll diagnose the issue and explain your options.</p>
      <div style="display:flex; gap: var(--space-xs); justify-content:center; flex-wrap:wrap;">
        <a href="#quote-form" class="btn btn--primary">Request a Repair Appointment</a>
        <a href={business.phoneHref} class="btn btn--outline">Call Ocean Prime</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .image-placeholder {
    margin-top: var(--space-md);
    height: 220px;
    border-radius: var(--radius-card);
    background: var(--color-prime-blue-tint);
    border: 1px dashed var(--color-prime-blue-border);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-prime-blue);
    font-size: var(--fs-small);
    padding: 0 var(--space-md);
  }
</style>
