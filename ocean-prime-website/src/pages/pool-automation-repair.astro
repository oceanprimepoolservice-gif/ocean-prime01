---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import business from '../data/business.json';

const faqs = [
  { question: 'Which automation brands do you support?', answer: '[Needs confirmation \u2014 list actual supported brands, e.g. Pentair, Jandy, Hayward]' },
  { question: 'My app won\u2019t connect to my pool equipment \u2014 can you fix that?', answer: 'Yes \u2014 connectivity issues are one of the most common automation problems we resolve.' },
  { question: 'Can you upgrade my pool to app-based automation?', answer: '[Needs confirmation \u2014 does Ocean Prime install new automation systems or only repair existing ones?]' },
  { question: 'Why isn\u2019t my heater or light responding to scheduled commands?', answer: 'This usually points to a communication issue between the automation controller and the equipment itself \u2014 we\u2019ll test each component individually.' },
];
---

<BaseLayout
  title="Pool Automation Repair in Naples, FL | Ocean Prime"
  description="Professional pool automation repair in Naples, Bonita Springs, Estero & Marco Island. Fix app connectivity, scheduling, and equipment control issues."
  path="/pool-automation-repair/"
  simplifiedHeader={true}
>
  <section class="section container">
    <h1>Pool Automation Repair in Naples, Florida</h1>
    <p style="max-width: 60ch;">Get your app-controlled pool equipment responding the way it should.</p>
    <div style="display:flex; gap: var(--space-xs); flex-wrap:wrap;">
      <a href={business.phoneHref} class="btn btn--primary">Call for Automation Service</a>
      <a href="#quote-form" class="btn btn--outline">Request a Repair Appointment</a>
    </div>
    <div class="image-placeholder">Real photo placeholder &mdash; technician configuring pool automation</div>
  </section>

  <section class="section container">
    <QuoteForm heading="Request a Repair Appointment" variant="repair" />
  </section>

  <section class="section section--tint container">
    <h2>Common Automation Problems We Fix</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>App won't connect to pool equipment</li>
      <li>Equipment not responding to commands</li>
      <li>Scheduling not working as programmed</li>
      <li>Light control failures</li>
      <li>Heater control failures</li>
      <li>Pump communication errors</li>
    </ul>
  </section>

  <section class="section container">
    <h2>What's Included</h2>
    <ul style="color: var(--color-ink-secondary); font-size: var(--fs-small); line-height: 2;">
      <li>Full system connectivity diagnostic</li>
      <li>Individual component testing (pump, heater, lights, salt system)</li>
      <li>Controller and app configuration check</li>
      <li>Clear explanation of what was wrong and what was fixed</li>
    </ul>
  </section>

  <section class="section section--tint container">
    <h2>Automation Repair Throughout Southwest Florida</h2>
    <p>In addition to Naples, Ocean Prime repairs pool automation systems in Bonita Springs, Estero, and Marco Island. <a href="/service-areas/">See our full service area &rarr;</a></p>
  </section>

  <section class="section container">
    <h2>Automation Questions</h2>
    <FAQAccordion items={faqs} />
  </section>

  <section class="section section--tint">
    <div class="container" style="text-align:center;">
      <h2>Get Your Pool Automation Working Again</h2>
      <p>Request a repair appointment and we'll get your app back in control of your pool.</p>
      <div style="display:flex; gap: var(--space-xs); justify-content:center; flex-wrap:wrap;">
        <a href="#quote-form" class="btn btn--primary">Request a Repair Appointment</a>
        <a href={business.phoneHref} class="btn btn--outline">Call Ocean Prime</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .image-placeholder {
    margin-top: var(--space-md);
    height: 220px;
    border-radius: var(--radius-card);
    background: var(--color-prime-blue-tint);
    border: 1px dashed var(--color-prime-blue-border);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-prime-blue);
    font-size: var(--fs-small);
    padding: 0 var(--space-md);
  }
</style>
